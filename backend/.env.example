# ====================================
# EMLAKDRONE - BACKEND ENVIRONMENT
# ====================================

# Application
NODE_ENV=production
PORT=3001
APP_URL=https://api.emlakdrone.com
FRONTEND_URL=https://emlakdrone.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@postgres:5432/emlakdrone?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production
REFRESH_TOKEN_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.emlakdrone.com/api/auth/google/callback

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Iyzico Payment
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_BASE_URL=https://api.iyzipay.com

# Email (SMTP)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_NAME=EmlakDrone
SMTP_FROM_EMAIL=noreply@emlakdrone.com

# MinIO Storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=emlakdrone-videos
MINIO_USE_SSL=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Video Processing
VIDEO_QUALITY_1080P=1920x1080
VIDEO_QUALITY_4K=3840x2160
VIDEO_FRAMERATE=30
VIDEO_BITRATE_1080P=5000k
VIDEO_BITRATE_4K=15000k
MAX_RENDER_RETRIES=3

# Queue
QUEUE_CONCURRENCY=2

# Logging
LOG_LEVEL=info

# Admin Credentials (for seed)
ADMIN_EMAIL=admin@emlakdrone.com
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
