# ============================================
# AERVO - ENVIRONMENT VARIABLES
# ============================================

# ============ APPLICATION ============
NODE_ENV=production
APP_NAME=Aervo
APP_URL=https://aervo.io
FRONTEND_URL=https://aervo.io
BACKEND_URL=https://api.aervo.io

# ============ DATABASE ============
DATABASE_URL=postgresql://aervo:your_secure_password_here@postgres:5432/aervo

# ============ REDIS ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ JWT & AUTH ============
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key
REFRESH_TOKEN_EXPIRES_IN=30d

# ============ GOOGLE OAUTH ============
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.aervo.io/api/auth/google/callback

# ============ GOOGLE MAPS ============
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Alternatif: Mapbox
# MAPBOX_ACCESS_TOKEN=your_mapbox_token

# ============ PAYMENT - IYZICO ============
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_BASE_URL=https://api.iyzipay.com

# Test için:
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ============ EMAIL - SMTP ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@aervo.io
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME=Aervo
SMTP_FROM_EMAIL=noreply@aervo.io

# ============ MINIO (S3 Storage) ============
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=aervo_admin
MINIO_SECRET_KEY=your_minio_secret_key_change_this
MINIO_BUCKET=aervo-videos
MINIO_USE_SSL=false

# Production için CDN URL
# CDN_URL=https://cdn.aervo.io

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============ VIDEO PROCESSING ============
VIDEO_QUALITY_1080P=1920x1080
VIDEO_QUALITY_4K=3840x2160
VIDEO_FRAMERATE=30
VIDEO_BITRATE_1080P=5000k
VIDEO_BITRATE_4K=15000k
MAX_RENDER_RETRIES=3

# ============ QUEUE ============
QUEUE_CONCURRENCY=2

# ============ LOGGING ============
LOG_LEVEL=info
# options: error, warn, info, debug

# ============ BACKUP ============
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ============ ADMIN ============
ADMIN_EMAIL=admin@aervo.io
ADMIN_PASSWORD=Admin123!ChangeThis
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
